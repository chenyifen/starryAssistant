<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121212"
    android:fillViewport="true"
    android:padding="11dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设备激活管理"
            android:textColor="#FF4ADFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:shadowColor="#804ADFFF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="4" />

        <!-- 状态显示卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/card_status_bg"
            android:padding="7dp"
            android:orientation="vertical">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="检查中..."
                android:textColor="#FF4ADFFF"
                android:textSize="13sp"
            android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

        <!-- 设备信息卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/card_device_info_bg"
            android:padding="7dp"
            android:orientation="vertical">

        <TextView
            android:id="@+id/tv_device_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设备信息"
                android:textColor="#FFFFFFFF"
                android:textSize="9sp"
                android:lineSpacingMultiplier="1.4"
            android:gravity="start" />

        <!-- 授权码 -->
        <TextView
            android:id="@+id/tv_license_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="授权码: XXXX-XXXX-XXXX"
                android:textColor="#FF4DFFB8"
                android:textSize="9sp"
            android:visibility="gone"
                android:layout_marginTop="4dp" />

        <!-- 激活时间 -->
        <TextView
            android:id="@+id/tv_activation_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="激活时间: 2024-01-01 00:00:00"
            android:textColor="#FFCCCCCC"
                android:textSize="9sp"
            android:visibility="gone"
                android:layout_marginTop="3dp" />

        <!-- 过期时间 -->
        <TextView
            android:id="@+id/tv_expiry_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="过期时间: 永久有效"
            android:textColor="#FFCCCCCC"
                android:textSize="9sp"
            android:visibility="gone"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_activate"
                android:layout_width="80dp"
                android:layout_height="27dp"
                android:text="输入激活码"
                android:textSize="11sp"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/btn_activation_primary"
                android:focusable="true"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/btn_check_status"
                android:layout_width="80dp"
                android:layout_height="27dp"
                android:text="检查状态"
                android:textSize="11sp"
                android:textColor="#FF4ADFFF"
                android:background="@drawable/btn_activation_secondary"
                android:focusable="true"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/btn_continue"
                android:layout_width="80dp"
                android:layout_height="27dp"
                android:text="继续使用"
                android:textSize="11sp"
                android:textColor="#FF4DFFB8"
                android:background="@drawable/btn_activation_success"
                android:focusable="true"
                android:visibility="gone"
                android:layout_margin="3dp" />

            <Button
                android:id="@+id/btn_clear_activation"
                android:layout_width="67dp"
                android:layout_height="27dp"
                android:text="清除激活\n(长按)"
                android:textSize="8sp"
                android:textColor="#FFFF4444"
                android:background="@drawable/btn_activation_danger"
                android:focusable="true"
                android:layout_margin="3dp" />

        </LinearLayout>

        <!-- 激活码输入容器 -->
        <LinearLayout
            android:id="@+id/input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/card_input_bg"
            android:visibility="gone"
            android:padding="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请输入激活码"
                android:textColor="#FF9A4DFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp"
                android:layout_gravity="center"
                android:shadowColor="#809A4DFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="3" />

            <!-- 激活码输入区域 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:layout_marginBottom="7dp">

                <!-- 固定前缀 LS- -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LS-"
                    android:textColor="#FF4ADFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="3dp" />

                <!-- 第一段: 4个字符 -->
                <EditText
                    android:id="@+id/et_segment1_char1"
                    android:layout_width="20dp"
                    android:layout_height="27dp"
                    android:maxLength="1"
                    android:inputType="textCapCharacters"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF"
                    android:gravity="center"
                    android:background="@drawable/input_activation_code"
                    android:layout_marginEnd="1dp" />
                <EditText
                    android:id="@+id/et_segment1_char2"
                    android:layout_width="20dp"
                    android:layout_height="27dp"
                    android:maxLength="1"
                    android:inputType="textCapCharacters"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF"
                    android:gravity="center"
                    android:background="@drawable/input_activation_code"
                    android:layout_marginEnd="1dp" />
                <EditText
                    android:id="@+id/et_segment1_char3"
                    android:layout_width="20dp"
                    android:layout_height="27dp"
                    android:maxLength="1"
                    android:inputType="textCapCharacters"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF"
                    android:gravity="center"
                    android:background="@drawable/input_activation_code"
                    android:layout_marginEnd="1dp" />
                <EditText
                    android:id="@+id/et_segment1_char4"
                    android:layout_width="20dp"
                    android:layout_height="27dp"
                    android:maxLength="1"
                    android:inputType="textCapCharacters"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF"
                    android:gravity="center"
                    android:background="@drawable/input_activation_code"
                    android:layout_marginEnd="3dp" />

                <!-- 连字符 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="#FF9A4DFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="3dp" />

                <!-- 第二段: 4个字符 -->
                <EditText
                    android:id="@+id/et_segment2_char1"
                    android:layout_width="20dp"
                    android:layout_height="27dp"
                    android:maxLength="1"
                    android:inputType="textCapCharacters"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF"
                    android:gravity="center"
                    android:background="@drawable/input_activation_code"
                    android:layout_marginEnd="1dp" />
                <EditText
                    android:id="@+id/et_segment2_char2"
                    android:layout_width="20dp"
                    android:layout_height="27dp"
                    android:maxLength="1"
                    android:inputType="textCapCharacters"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF"
                    android:gravity="center"
                    android:background="@drawable/input_activation_code"
                    android:layout_marginEnd="1dp" />
                <EditText
                    android:id="@+id/et_segment2_char3"
                    android:layout_width="20dp"
                    android:layout_height="27dp"
                    android:maxLength="1"
                    android:inputType="textCapCharacters"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF"
                    android:gravity="center"
                    android:background="@drawable/input_activation_code"
                    android:layout_marginEnd="1dp" />
                <EditText
                    android:id="@+id/et_segment2_char4"
                    android:layout_width="20dp"
                    android:layout_height="27dp"
                    android:maxLength="1"
                    android:inputType="textCapCharacters"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF"
                    android:gravity="center"
                    android:background="@drawable/input_activation_code"
                    android:layout_marginEnd="3dp" />

                <!-- 连字符 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="#FF9A4DFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="3dp" />

                <!-- 第三段: 4个字符 -->
                <EditText
                    android:id="@+id/et_segment3_char1"
                    android:layout_width="20dp"
                    android:layout_height="27dp"
                    android:maxLength="1"
                    android:inputType="textCapCharacters"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF"
                    android:gravity="center"
                    android:background="@drawable/input_activation_code"
                    android:layout_marginEnd="1dp" />
                <EditText
                    android:id="@+id/et_segment3_char2"
                    android:layout_width="20dp"
                    android:layout_height="27dp"
                    android:maxLength="1"
                    android:inputType="textCapCharacters"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF"
                    android:gravity="center"
                    android:background="@drawable/input_activation_code"
                    android:layout_marginEnd="1dp" />
                <EditText
                    android:id="@+id/et_segment3_char3"
                    android:layout_width="20dp"
                    android:layout_height="27dp"
                    android:maxLength="1"
                    android:inputType="textCapCharacters"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF"
                    android:gravity="center"
                    android:background="@drawable/input_activation_code"
                    android:layout_marginEnd="1dp" />
                <EditText
                    android:id="@+id/et_segment3_char4"
                    android:layout_width="20dp"
                    android:layout_height="27dp"
                    android:maxLength="1"
                    android:inputType="textCapCharacters"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF"
                    android:gravity="center"
                    android:background="@drawable/input_activation_code"
                    android:layout_marginEnd="3dp" />

                <!-- 连字符 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="#FF9A4DFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="3dp" />

                <!-- 第四段: 1个字符 -->
            <EditText
                    android:id="@+id/et_segment4_char1"
                    android:layout_width="20dp"
                    android:layout_height="27dp"
                    android:maxLength="1"
                    android:inputType="textCapCharacters"
                    android:textSize="16sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                    android:background="@drawable/input_activation_code"
                    android:imeOptions="actionDone" />

            </LinearLayout>

            <!-- 提交按钮 -->
            <Button
                android:id="@+id/btn_submit"
                android:layout_width="93dp"
                android:layout_height="27dp"
                android:text="提交激活"
                android:textSize="11sp"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/btn_activation_primary"
                android:focusable="true"
                android:layout_gravity="center"
                android:layout_margin="3dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
