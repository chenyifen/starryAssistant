    <!-- 悬浮球尺寸配置 -->
    
    <!-- 悬浮球实际显示大小 (可直接修改此值来调整悬浮球大小) -->
    <dimen name="floating_orb_size">120dp</dimen>
    
    <!-- 悬浮球动画实际大小 -->
    <dimen name="floating_orb_animation_size">96dp</dimen>
    
    <!-- 悬浮球文本显示相关 -->
    
    <!-- 悬浮球下方文本与悬浮球的间距 -->
    <dimen name="floating_orb_text_margin_top">16dp</dimen>
    
    <!-- 悬浮球文本大小 -->
    <dimen name="floating_orb_text_size">14sp</dimen>
    
    <!-- 悬浮球状态文本大小 -->
    <dimen name="floating_orb_status_text_size">12sp</dimen>
    
    <!-- 快捷命令按钮大小 -->
    <dimen name="quick_command_button_size">48dp</dimen>
    
    <!-- 快捷命令按钮间距 -->
    <dimen name="quick_command_button_spacing">12dp</dimen>
